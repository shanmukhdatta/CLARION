# CLARION is single-user and offline by default.
# To permit deliberate case review writes, create a locally random >=24 char token:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Do not commit the resulting .env or put tokens in URLs.
CLARION_REVIEW_TOKEN=REPLACE_WITH_LOCAL_RANDOM_32_BYTE_SECRET
CLARION_REVIEWER_ID=local_operator

# The app always binds to 127.0.0.1 unless a future explicitly reviewed
# local authentication + TLS proxy architecture is deployed.
CLARION_RUNTIME_MODE=local_offline
